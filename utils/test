#!/usr/bin/env bash

FILE1="files/a_cifrar"
FILE2="files/cifrado"
FILE3="files/descifrado"
KEY="11234156"

mkdir -p files

fail=0

test() {
  local desc="$1"

  if ! ./main -c -i "$FILE1" -o "$FILE2" -k "$KEY" >/dev/null; then
    echo "FAIL (cifrado)  $desc"
    fail=1
    return
  fi

  if ! ./main -d -i "$FILE2" -o "$FILE3" -k "$KEY" >/dev/null; then
    echo "FAIL (descifrado) $desc"
    fail=1
    return
  fi

  if cmp -s "$FILE1" "$FILE3"; then
    echo "OK   $desc"
  else
    echo "FAIL (no coinciden) $desc"
    fail=1
  fi
}

# Test con urandom, hasta 100 MB
for n in 0 1 2 3 255 256 257 4095 10000 10000000 100000000; do
  head -c "$n" /dev/urandom >"$FILE1"
  test "urandom $n bytes"
done

# Test con todo ceros
head -c 1024 /dev/zero >"$FILE1"
test "todo ceros (1024 bytes)"

# Test con todo 0xFF
head -c 1024 /dev/zero | tr '\0' '\377' >"$FILE1"
test "todo 0xFF (1024 bytes)"

# Test con ciclo 0..255 repetido (cubre los 256 valores posibles)
python3 -c "import sys; sys.stdout.buffer.write(bytes(range(256))*4)" >"$FILE1"
test "ciclo 0..255 x4"

if [ "$fail" -eq 0 ]; then
  echo
  echo "Todos los tests han pasado"
else
  echo
  echo "Algun test ha fallado"
fi

exit $fail
